services:
  db:
    image: postgres:15
    container_name: contatos_db
    environment:
      POSTGRES_DB: contatos
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: admin
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U admin"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - app_net

  api:
    build: ./backend
    container_name: contatos_api
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - ./backend/.env
    environment:
      DATABASE_URL: postgresql://admin:admin@contatos_db:5432/contatos
      PORT: 3000
    volumes:
      - ./backend:/app
      - /app/node_modules
    networks:
      - app_net
      - proxy_net

  web:
    build: ./frontend
    container_name: contatos_web
    depends_on:
      - api
    networks:
      - app_net
      - proxy_net

volumes:
  postgres_data:

networks:
  app_net:
  proxy_net:
    external: true

