generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contato {
  id          Int        @id @default(autoincrement())
  nome        String     @db.VarChar(150)
  cargo       String?    @db.VarChar(100)
  empresa     String?    @db.VarChar(150)
  website     String?    @db.VarChar(150)
  email       String?    @db.VarChar(150)
  observacoes String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  enderecos   Endereco[]

  @@map("contatos")
}

model Endereco {
  id        Int        @id @default(autoincrement())
  contatoId Int        @map("contato_id")
  apelido   String?    @db.VarChar(100)
  tipo      TipoEndereco
  endereco  String?    @db.VarChar(200)
  bairro    String?    @db.VarChar(100)
  cidade    String?    @db.VarChar(100)
  cep       String?    @db.VarChar(15)
  uf        String?    @db.VarChar(2)
  pais      String?    @db.VarChar(50)
  telefones Telefone[]
  contato   Contato    @relation(fields: [contatoId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Telefone {
  id        Int         @id @default(autoincrement())
  enderecoId Int        @map("endereco_id")
  numero    String      @db.VarChar(20)
  tipo      TipoTelefone
  endereco  Endereco    @relation(fields: [enderecoId], references: [id], onDelete: Cascade)

  @@map("telefones")
}

enum TipoEndereco {
  COMERCIAL
  RESIDENCIAL
}

enum TipoTelefone {
  CELULAR
  FIXO
}
