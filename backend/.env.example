DATABASE_URL="postgresql://postgres:postgres@contatos_db:5432/ender"

# JWT
JWT_SECRET="your-secret-key-change-in-production-12345"
JWT_EXPIRATION="24h"

# Azure AD / Entra ID
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Redirect URI (Azure AD vai redirecionar para aqui)
AZURE_REDIRECT_URI=https://10.3.11.30/auth/callback

# Group Object IDs
ADMIN_GROUP_ID=your-admin-group-id
EDITOR_GROUP_ID=your-editor-group-id
READER_GROUP_ID=your-reader-group-id
